# Configuration example for local development
# Copy this file to .env.local for your local settings

# Next.js configuration
NEXT_PUBLIC_API_URL=https://data.economie.gouv.fr/api/explore/v2.1/catalog/datasets/prix-des-carburants-en-france-flux-instantane-v2/records

# API timeout (in milliseconds)
NEXT_PUBLIC_API_TIMEOUT=10000

# Cache duration (in seconds)
NEXT_PUBLIC_CACHE_DURATION=300

# Default search parameters
NEXT_PUBLIC_DEFAULT_LIMIT=50
NEXT_PUBLIC_MAX_LIMIT=100
NEXT_PUBLIC_DEFAULT_RADIUS=10